# Copy to .env; docker compose reads it. Everything here is optional.

# Which coronagraph every command works on: ccor1 (default), ccor2, c2 or c3.
# See kreutz/instrument.py. Usually set per command instead.
#KREUTZ_INSTRUMENT=ccor1

# CPU cap per container (docker compose `cpus`). Default 1.5.
#KREUTZ_CPUS=1.5

# Host port for the status page (docker compose up -d web). Default 8000.
#KREUTZ_WEB_PORT=8000

# Where kreutz.notify posts live alerts (the watcher's --notify). No topic,
# no pages. Pick a topic name nobody will guess; ntfy topics are public.
#NTFY_SERVER=https://ntfy.sh
#NTFY_TOPIC=
